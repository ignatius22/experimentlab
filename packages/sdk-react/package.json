{
  "name": "experimentlab-react",
  "version": "0.1.3",
  "description": "React hooks and context provider for ExperimentLab feature flags and A/B experiments",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --clean --external react,react-dom --no-splitting",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "node ../../scripts/check-package.mjs",
    "prepublishOnly": "pnpm build && pnpm check:package"
  },
  "dependencies": {
    "experimentlab-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

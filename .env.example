# ExperimentLab Environment Configuration

# Database Configuration
POSTGRES_USER="experiment_user"
POSTGRES_PASSWORD="generate_a_strong_database_password_here"
POSTGRES_DB="experimentlab_db"
DATABASE_URL="postgresql://experiment_user:generate_a_strong_database_password_here@postgres:5432/experimentlab_db?schema=public"

# Redis-backed event ingestion queue
REDIS_URL="redis://redis:6379"
EVENT_WORKER_CONCURRENCY="20"
EVENT_WORKER_BATCH_SIZE="500"
EVENT_WORKER_FLUSH_MS="250"

# Authentication Security (REQUIRED in production - generate with `openssl rand -hex 32`)
AUTH_SECRET="generate_a_secure_random_64_character_hex_secret_here"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"
